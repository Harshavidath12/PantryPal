<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_bg"
    tools:context=".MainActivity">

    <!-- PANTRY HOME DASHBOARD CONTAINER -->
    <include
        android:id="@+id/pantryHomeScreenContainer"
        layout="@layout/layout_pantry_home_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SHOPPING SCREEN CONTAINER -->
    <include
        android:id="@+id/shoppingScreenContainer"
        layout="@layout/layout_shopping_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FULL PANTRY ITEMS SCREEN CONTAINER -->
    <include
        android:id="@+id/fullPantryItemsScreenContainer"
        layout="@layout/layout_full_pantry_items_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- NOTIFICATIONS SCREEN CONTAINER (OVERLAY) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notificationsScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/pantry_bg"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header Section (Back Arrow, Title, Subtitle, Sync) -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Arrow Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <!-- Title & Subtitle Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_alerts_reminders"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPantrySyncedSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle_pantry_synced"
                    android:textColor="@color/pantry_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Sync Button -->
            <FrameLayout
                android:id="@+id/btnSync"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_sync"
                    android:src="@drawable/ic_sync" />
            </FrameLayout>

        </LinearLayout>

        <!-- Horizontal Scroll Filter Chips Row -->
        <HorizontalScrollView
            android:id="@+id/filterScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/headerSection">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- All Chip -->
                <LinearLayout
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/tvChipAllText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_all"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/tvChipAllCount"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_circle"
                        android:gravity="center"
                        android:textColor="@color/pantry_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="4" />

                </LinearLayout>

                <!-- Expiry Chip -->
                <LinearLayout
                    android:id="@+id/chipExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/tvChipExpiryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_expiry"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/tvChipExpiryCount"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_circle"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="3" />

                </LinearLayout>

                <!-- Sync & Shared Chip -->
                <LinearLayout
                    android:id="@+id/chipSyncShared"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/filter_sync_shared"
                        android:src="@drawable/ic_people"
                        app:tint="@color/chip_unselected_text" />

                    <TextView
                        android:id="@+id/tvChipSyncText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_sync_shared"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Main Content Feed (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filterScrollView"
            tools:listitem="@layout/item_expiry_alert" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SURPLUS HUB -->
    <include
        android:id="@+id/surplusScreenContainer"
        layout="@layout/layout_surplus_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/surplusDetailContainer"
        layout="@layout/layout_surplus_donation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Add Screen Container -->
    <include
        android:id="@+id/addScreenContainer"
        layout="@layout/layout_add_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile Screen Container -->
    <include
        android:id="@+id/profileScreenContainer"
        layout="@layout/layout_profile_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Navigation Bar Card -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/bottomNavCard"
          style="@style/PantryCardStyle"
          android:layout_width="match_parent"
          android:layout_height="56dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout android:id="@+id/navPantry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/ivNavPantry" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/nav_pantry" android:src="@drawable/ic_pantry" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvNavPantry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/nav_pantry" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/fabAddAlert" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/ivNavAdd" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/cd_add_new_alert" android:src="@drawable/ic_add_tab" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvNavAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Add" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navShopping" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/ivNavShopping" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/nav_shopping" android:src="@drawable/ic_shopping" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvNavShopping" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/nav_shopping" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navSurplus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/ivNavSurplus" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/nav_surplus" android:src="@drawable/ic_leaf" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvNavSurplus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/nav_surplus" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/ivNavProfile" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@string/cd_profile" android:src="@drawable/ic_person" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/tvNavProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/nav_profile" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout></com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
