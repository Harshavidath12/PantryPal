<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_bg"
    tools:context=".MainActivity">

    <!-- PANTRY SCREEN CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pantryScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_pantry"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Bell Icon Button -->
            <FrameLayout
                android:id="@+id/btnBell"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_notifications"
                    android:src="@drawable/ic_bell" />

                <!-- Red Dot Badge -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tag_red" />
            </FrameLayout>

            <!-- User Profile Avatar Button -->
            <FrameLayout
                android:id="@+id/btnProfileAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_green"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_profile"
                    android:src="@drawable/ic_person" />
            </FrameLayout>

        </LinearLayout>

        <!-- Header Section (Back Arrow, Title, Subtitle, Sync) -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <!-- Back Arrow Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <!-- Title & Subtitle Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_alerts_reminders"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPantrySyncedSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle_pantry_synced"
                    android:textColor="@color/pantry_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Sync Button -->
            <FrameLayout
                android:id="@+id/btnSync"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_sync"
                    android:src="@drawable/ic_sync" />
            </FrameLayout>

        </LinearLayout>

        <!-- Horizontal Scroll Filter Chips Row -->
        <HorizontalScrollView
            android:id="@+id/filterScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/headerSection">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- All Chip -->
                <LinearLayout
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/tvChipAllText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_all"
                        android:textColor="@color/chip_selected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/tvChipAllCount"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_circle"
                        android:gravity="center"
                        android:textColor="@color/pantry_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="4" />

                </LinearLayout>

                <!-- Expiry Chip -->
                <LinearLayout
                    android:id="@+id/chipExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/tvChipExpiryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_expiry"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Count Badge -->
                    <TextView
                        android:id="@+id/tvChipExpiryCount"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_circle"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="3" />

                </LinearLayout>

                <!-- Sync & Shared Chip -->
                <LinearLayout
                    android:id="@+id/chipSyncShared"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/filter_sync_shared"
                        android:src="@drawable/ic_people"
                        app:tint="@color/chip_unselected_text" />

                    <TextView
                        android:id="@+id/tvChipSyncText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_sync_shared"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Main Content Feed (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filterScrollView"
            tools:listitem="@layout/item_expiry_alert" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SHOPPING SCREEN CONTAINER -->
    <include
        android:id="@+id/shoppingScreenContainer"
        layout="@layout/layout_shopping_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SURPLUS HUB -->
    <FrameLayout
        android:id="@+id/surplusScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Surplus hub" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Share good food. Strengthen your community." android:textColor="@color/text_secondary" android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/pantry_primary">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GIVE FOOD A SECOND LIFE" android:textColor="#CCFFFFFF" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Have extra food?" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Connect with a nearby community hub and help reduce food waste." android:textColor="@color/white" android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnFlagSurplus" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Flag surplus food" android:textAllCaps="false" android:textColor="@color/pantry_primary" app:backgroundTint="@color/white" app:cornerRadius="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Your community impact" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥬  FOOD SAVED" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold"/><TextView android:id="@+id/tvFoodSaved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="12.5 kg" android:textColor="@color/pantry_primary" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="this month" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤝  DONATIONS" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold"/><TextView android:id="@+id/tvDonations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="8" android:textColor="@color/pantry_primary" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="completed" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nearby community hubs" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/btnFindHub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="8dp" android:text="See all  →" android:textColor="@color/pantry_primary" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp"><TextView android:layout_width="46dp" android:layout_height="46dp" android:gravity="center" android:text="📍" android:textSize="22sp" android:background="@color/pantry_primary_light"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Green Path Community Pantry" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Open until 6:00 PM · 1.2 km" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/pantry_primary" android:textSize="28sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Recent donations" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🍞  Wholegrain bread · 2 loaves" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Green Path Pantry  ·  Yesterday   ✓ Received" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🥕  Fresh vegetables · 1.5 kg" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Hope Food Bank  ·  12 Oct   ✓ Received" android:textColor="@color/text_secondary" android:textSize="12sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        style="@style/PantryCardStyle"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 1. Pantry Tab -->
            <LinearLayout
                android:id="@+id/navPantry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavPantry"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_pantry"
                    android:src="@drawable/ic_pantry"
                    app:tint="@color/pantry_primary" />

                <TextView
                    android:id="@+id/tvNavPantry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_pantry"
                    android:textColor="@color/pantry_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Shopping Tab -->
            <LinearLayout
                android:id="@+id/navShopping"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavShopping"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_shopping"
                    android:src="@drawable/ic_shopping"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavShopping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_shopping"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. The Center Green + Button -->
            <!-- Inline directly into the Nav Bar so it aligns perfectly in the flow -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/fabAddAlert"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_fab"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_add_new_alert"
                        android:src="@drawable/ic_plus" />
                </FrameLayout>
            </LinearLayout>


            <!-- 4. Surplus Tab -->
            <LinearLayout
                android:id="@+id/navSurplus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavSurplus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_surplus"
                    android:src="@drawable/ic_leaf"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavSurplus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_surplus"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 5. Profile Tab -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/cd_profile"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvNavProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_profile"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
