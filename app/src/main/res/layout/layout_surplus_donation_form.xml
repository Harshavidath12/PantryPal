<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/layoutFlagForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <FrameLayout android:id="@+id/btnAddSurplusPhoto" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="12dp" android:background="@drawable/bg_surplus_photo" android:clickable="true" android:focusable="true" android:contentDescription="Add produce photo">
                        <ImageView android:id="@+id/ivSurplusPhoto" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                            <TextView android:id="@+id/tvSurplusPhotoPrompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="📷\nAdd produce photo\nSnap or upload a photo to help neighbours identify the food" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Item description" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/etSurplusName" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_sync_card" android:hint="Mixed garden vegetables" android:paddingHorizontal="10dp" android:singleLine="true" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantity / Unit" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                            <RadioGroup android:id="@+id/rgQuantityMode" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="3dp" android:orientation="horizontal">
                                <RadioButton android:id="@+id/rbQuantityKg" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_sync_card" android:buttonTint="@color/pantry_primary" android:checked="true" android:gravity="center" android:padding="0dp" android:text="Kg" android:textSize="10sp"/>
                                <RadioButton android:id="@+id/rbQuantityUnits" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_sync_card" android:buttonTint="@color/pantry_primary" android:gravity="center" android:padding="0dp" android:text="Units" android:textSize="10sp"/>
                            </RadioGroup>
                            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="3dp">
                                <EditText android:id="@+id/etSurplusQuantity" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_sync_card" android:hint="2.3" android:inputType="numberDecimal" android:paddingStart="8dp" android:paddingEnd="36dp" android:singleLine="true" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvQuantitySuffix" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end|center_vertical" android:gravity="center" android:paddingEnd="9dp" android:text="kg" android:textColor="@color/pantry_primary_dark" android:textSize="11sp" android:textStyle="bold"/>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Best before" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/><EditText android:id="@+id/etSurplusExpiry" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_sync_card" android:clickable="true" android:drawableEnd="@drawable/ic_calendar" android:drawablePadding="6dp" android:drawableTint="@color/pantry_primary" android:focusable="false" android:focusableInTouchMode="false" android:hint="Select date" android:paddingHorizontal="8dp" android:singleLine="true" android:textSize="11sp"/></LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Pickup preference" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                    <RadioGroup android:id="@+id/rgSurplusPickup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <RadioButton android:id="@+id/rbSurplusCourier" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_sync_card" android:buttonTint="@color/pantry_primary" android:checked="true" android:paddingHorizontal="6dp" android:text="Today (2–5 PM)\nPantry courier" android:textSize="10sp"/>
                        <RadioButton android:id="@+id/rbSurplusDropoff" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_sync_card" android:buttonTint="@color/pantry_primary" android:paddingHorizontal="6dp" android:text="Drop off hub\nSelf deposit" android:textSize="10sp"/>
                    </RadioGroup>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Food safety standards" android:textColor="@color/pantry_primary" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Only fresh, safe and sealed food can be shared." android:textColor="@color/text_secondary" android:textSize="10sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnChooseHub" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Find a hub" android:textAllCaps="false" android:visibility="gone" app:backgroundTint="@color/pantry_primary" app:cornerRadius="15dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitDonation" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:layout_marginBottom="18dp" android:text="Submit for Volunteer Pickup" android:textAllCaps="false" android:textColor="@color/pantry_primary_dark" app:backgroundTint="#FFB84D" app:cornerRadius="15dp" app:icon="@drawable/ic_delivery_truck" app:iconGravity="textStart" app:iconPadding="8dp" app:iconTint="@color/pantry_primary_dark"/>
                </LinearLayout>
