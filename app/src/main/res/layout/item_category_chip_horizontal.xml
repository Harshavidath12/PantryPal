<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llCategoryChip"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/tvCategoryChipName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/chip_unselected_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Vegetables" />

    <TextView
        android:id="@+id/tvCategoryChipCount"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_badge_circle"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="12" />

</LinearLayout>