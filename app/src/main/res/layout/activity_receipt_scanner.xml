<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#102B24">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/receiptPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingBottom="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#D9102B24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receipt OCR"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Align paper receipt inside the frame and tap Scan"
            android:textColor="#D8F4E8"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Center Guide Frame -->
    <View
        android:layout_width="280dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_method_card"
        android:alpha="0.25" />

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="40dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#D9102B24">

        <!-- Demo Receipt Button (Instant Test) -->
        <TextView
            android:id="@+id/btnDemoReceipt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Demo"
            android:textColor="#D8F4E8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_quantity_button" />

        <!-- Gallery Pick Button -->
        <TextView
            android:id="@+id/btnPickGallery"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🖼 Gallery"
            android:textColor="#D8F4E8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_quantity_button" />

        <!-- Capture Shutter Button -->
        <TextView
            android:id="@+id/btnCaptureReceipt"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="📸 Scan"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_confirm_button" />

    </LinearLayout>

    <!-- Progress Indicator Overlay -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#377E6A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reading receipt text with ML Kit..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
