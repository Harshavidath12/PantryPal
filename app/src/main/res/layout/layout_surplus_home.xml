<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/surplusScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp" tools:layout_height="match_parent"
        android:visibility="gone" tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Surplus" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnCommunityImpact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="8dp" android:text="Impact  ↗" android:textColor="@color/pantry_primary" android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/pantry_primary_light"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Redistribution Hub\nCommunity food sharing near you" android:textColor="@color/pantry_primary_dark" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nearby  ·  Open" android:textColor="@color/pantry_primary" android:textSize="13sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/pantry_primary_light">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIST FOOD TO SHARE" android:textColor="@color/pantry_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Flag surplus food" android:textColor="@color/pantry_primary_dark" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Connect good food with a nearby community." android:textColor="@color/text_secondary" android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnFlagSurplus" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="＋  Flag surplus" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/pantry_primary" app:cornerRadius="15dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Community impact" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥬  FOOD SAVED" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/tvFoodSaved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0.0 kg" android:textColor="@color/pantry_primary" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="total rescued" android:textColor="@color/text_secondary" android:textSize="14sp"/></LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤝  DONATIONS" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/tvDonations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/pantry_primary" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="completed" android:textColor="@color/text_secondary" android:textSize="14sp"/></LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nearby community hubs" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/btnFindHub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:padding="8dp" android:text="See all  →" android:textColor="@color/pantry_primary" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:id="@+id/homeHubList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_sync_card" android:padding="14dp" android:text="Loading nearby community hubs…" android:textColor="@color/text_secondary" android:textSize="13sp"/></LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:id="@+id/tvRecentDonationTitle" android:text="Recent donations" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/homeRecentDonationList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_sync_card" android:padding="14dp" android:text="Loading shared donations…" android:textColor="@color/text_secondary" android:textSize="13sp"/></LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
