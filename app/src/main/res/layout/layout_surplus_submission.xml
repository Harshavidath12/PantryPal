<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/layoutSubmission" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="4dp" android:visibility="gone">
                    <TextView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="22dp" android:background="@drawable/bg_circle_icon" android:gravity="center" android:text="✓" android:textColor="@color/pantry_primary" android:textSize="38sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Submitted" android:textColor="@color/pantry_primary_dark" android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvSubmissionSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Mixed vegetables · 2.3 kg has been added to your pickup queue." android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvSubmissionCo2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_sync_card" android:gravity="center" android:padding="8dp" android:text="♻  Est. 5.8 kg CO₂ emissions prevented" android:textColor="@color/pantry_primary_dark" android:textSize="10sp"/>
                    <com.google.android.material.card.MaterialCardView style="@style/PantryCardStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_sync_card" android:gravity="center" android:text="♧" android:textColor="@color/pantry_primary"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Donation Batch" android:textColor="@color/text_secondary" android:textSize="9sp"/><TextView android:id="@+id/tvSubmittedFood" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mixed vegetables" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_sync_card" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="Ready" android:textColor="@color/pantry_primary" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◷  Net Weight" android:textColor="@color/text_secondary" android:textSize="10sp"/><TextView android:id="@+id/tvSubmittedWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.3 kg" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◷  Est. Window" android:textColor="@color/text_secondary" android:textSize="10sp"/><TextView android:id="@+id/tvSubmittedWindow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today, 2:00 PM – 5:00 PM" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◷  Status" android:textColor="@color/text_secondary" android:textSize="10sp"/><TextView android:id="@+id/tvSubmittedStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Queued for pickup" android:textColor="#A77A16" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
                    </LinearLayout></com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_sync_card" android:padding="10dp" android:text="ⓘ  Please keep the crate sealed at room temperature or refrigerated until your volunteer arrives." android:textColor="@color/text_secondary" android:textSize="10sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTrackDonation" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="◎  Track My Donation" android:textAllCaps="false" android:textColor="@color/pantry_primary_dark" app:backgroundTint="#FFB84D" app:cornerRadius="17dp"/>
                    <TextView android:id="@+id/btnAnotherDonation" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:text="Add another donation or return home" android:textColor="@color/pantry_primary_dark" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
