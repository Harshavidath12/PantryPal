<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PantryPal" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize primary colors -->
        <item name="colorPrimary">@color/pantry_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pantry_primary_container</item>
        <item name="android:windowBackground">@color/pantry_bg</item>
        <item name="android:statusBarColor">@color/pantry_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PantryPal" parent="Base.Theme.PantryPal" />

    <!-- Rounded Card Style -->
    <style name="PantryCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/pantry_card_bg</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Rounded Button Style -->
    <style name="PantryActionButtonStyle" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>